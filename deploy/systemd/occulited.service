# openccu-lite: the system service under systemd. Installed by the fork's
# package/occulited; every product is systemd, the busybox init script is gone.
# Runs as the occulite user; root work goes through occulited-helper.service.
[Unit]
StartLimitIntervalSec=0
Description=openccu-lite system service (occulited)
Documentation=https://github.com/hobbyquaker/openccu-lite
# occu-etc-writable makes /etc/passwd and /etc/group writable, which the confined-addon
# policy switch needs before it can call adduser through the helper. After= but not Requires=:
# a box whose addons all run as root has no use for it, and the admin interface must come up
# either way - a daemon that refuses to start because a user could not be created is worse than
# one that reports the failure on the page.
#
# Not Before=lighttpd: lighttpd starts right after the network beside this daemon, and answers with
# its waiting page until this one answers (READY=1, below).
After=network.target occulited-helper.service occu-etc-writable.service
Requires=occulited-helper.service
Before=addons.target
Wants=lighttpd.service

[Service]
# Started only once the API answers. The daemon asks its own server for /api/meta/v1/version and
# then sends READY=1 to systemd (internal/sdnotify, no libsystemd), so After=occulited.service
# means "occulited answers" for every addon unit and addons.target, not merely "the process
# exists" (an addon started that way met lighttpd's 503 "starting"). Until then the unit is
# "activating" and the waiting page says "starting".
# TimeoutStartSec: a healthy start at boot takes about 2 s on an x86_64 VM, 2 to 13 s on a Pi 4 and
# 18 s on a Pi 3; the limit leaves room for a loaded system and for a start that migrates the state
# after an update - a start killed half-way would only begin again from the top.
# No WatchdogSec: a busy Pi 3 (a backup, an update being unpacked) must not be killed for
# answering late, and a crash already ends in Restart=always.
Type=notify
NotifyAccess=main
TimeoutStartSec=300
User=occulite
Group=occulite
# the journal for the Log page, the addon users' files for the policy switch
SupplementaryGroups=systemd-journal
# The directories the unprivileged daemon owns exist before the sandbox is built: the session
# mirror and the legacy alias mirror through RuntimeDirectory= (0711: the gate and
# addon CGIs open a sid they hold, nobody lists), the state dir through tmpfiles.d/occulited.conf
# (in every backup). An ExecStartPre cannot do it - ProtectSystem=strict needs ReadWritePaths= to
# exist first. occulite/wpa is the daemon's end of wpa_supplicant's control protocol;
# occulite/gate-tokens is the gate's token mirror (an API token with the scope addon:<id> opens
# that addon's pages as Authorization: Bearer); occulite/public-views names, while the Control app's
# public mode is on, the addons whose views it shows (the gate lets their pages' GETs through).
RuntimeDirectory=occulite/sessions occulite/legacy-sessions occulite/gate-tokens occulite/wpa occulite/public-views
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
# lighttpd's waiting page says whether this service is starting,
# restarting after a crash, in a crash loop or stopped on purpose - from a small file in /run that
# these hooks keep as root around every run, outside the sandbox ("+") and never in the way of a
# start ("-"). The script needs nothing of this daemon, its helper or the userfs.
ExecStartPre=-+/usr/libexec/occulited/unit-state start
ExecStart=/usr/bin/occulited --config /usr/local/etc/occulite/occulited.json --session-dir /run/occulite/sessions
ExecStartPost=-+/usr/libexec/occulited/unit-state up
ExecStopPost=-+/usr/libexec/occulited/unit-state stop
# essential: always back, with backoff instead of a tight loop: 2 s doubling to 5 min,
# never giving up. A loop is reported instead: the waiting page while it lasts, the
# Status page's occulited-crash-loop warning once the daemon runs again.
Restart=always
RestartSec=2
RestartSteps=8
RestartMaxDelaySec=300
# stdout/stderr go to the journal. occulited sees that ($JOURNAL_STREAM) and writes its own lines over
# journald's native protocol: the message alone, the real priority, the area as a field.
# stderr keeps what the runtime prints itself (a panic).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=occulited
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/usr/local/etc/occulite /run/occulite/sessions /run/occulite/legacy-sessions /run/occulite/gate-tokens /run/occulite/public-views
PrivateTmp=yes
# The sandbox. Everything root does for the daemon goes through occulited-helper.service, so
# this process and the programs it starts (journalctl, systemctl's read-only verbs,
# systemd-analyze, chronyc, dmesg, busybox mkpasswd and uname) need no capability, no device
# node beyond the pseudo ones, no syscall outside systemd's @system-service set and no socket
# family beyond unix, IPv4/IPv6 and netlink (net.Interfaces for the Network page and the
# discovery responders). The seccomp-backed lines are enforced since systemd is built with
# libseccomp; a blocked syscall kills the process with SIGSYS ("Bad system call" in the
# journal) rather than failing quietly, which is what makes a gap visible. syslog(2) is allowed
# by name so that dmesg keeps failing with EPERM as it does today (no CAP_SYSLOG, dmesg_restrict)
# instead of a signal; the Log page's kernel source reads the journal then. No ~@privileged
# line: it would take @setuid away again, and busybox, setuid root, drops that privilege with
# setresuid/setresgid at every applet's start (mkpasswd, uname). No ~@resources line: Go raises
# RLIMIT_NOFILE with prlimit64 at start.
# Left out on purpose: ProtectHostname= (a private UTS namespace never sees the hostname the
# helper sets later), ProtectProc=/ProcSubset= (the Services page lists the addons' processes,
# the Status page reads /proc/sys, meminfo and loadavg), PrivateDevices= (the radio and storage
# pages stat the device nodes), PrivateUsers= (the journal's group would map to nobody),
# ProtectKernelLogs= (its seccomp rule on syslog(2) would kill dmesg), and IPAddressDeny= (the
# catalogue, the update feed, the MQTT broker and the metadata import are LAN and internet by
# design).
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service syslog
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
DevicePolicy=closed
RemoveIPC=yes
# Files the daemon creates are private unless the code says otherwise: the session mirror and
# the local token set their world-readable mode explicitly.
UMask=0077

[Install]
WantedBy=multi-user.target
