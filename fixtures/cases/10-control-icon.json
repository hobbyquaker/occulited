{
  "title": "Control's switch icon (occulited task 99) is the control namespace: set beside other namespaces, replaced, removed for automatic; the store does not interpret it",
  "start": "empty",
  "ops": [
    {
      "op": "object.set",
      "ref": "HmIP-RF.A:3",
      "body": {
        "name": "Steckdosen Werkstatt",
        "meta": {
          "ccu-jack": {
            "hidden": false
          }
        }
      },
      "expect": {
        "ok": true,
        "revision": 1
      }
    },
    {
      "op": "object.set",
      "ref": "HmIP-RF.A:3",
      "body": {
        "meta": {
          "control": {
            "icon": "message_socket"
          }
        }
      },
      "expect": {
        "ok": true,
        "revision": 2
      }
    },
    {
      "op": "object.get",
      "ref": "HmIP-RF.A:3",
      "expect": {
        "value": {
          "name": "Steckdosen Werkstatt",
          "meta": {
            "ccu-jack": {
              "hidden": false
            },
            "control": {
              "icon": "message_socket"
            }
          }
        }
      }
    },
    {
      "op": "object.set",
      "ref": "HmIP-RF.A:3",
      "body": {
        "meta": {
          "control": {
            "icon": "vent_ventilation"
          }
        }
      },
      "expect": {
        "ok": true,
        "revision": 3
      }
    },
    {
      "op": "object.set",
      "ref": "HmIP-RF.A:3",
      "body": {
        "meta": {
          "control": {
            "icon": "vent_ventilation"
          }
        }
      },
      "expect": {
        "ok": true,
        "unchanged": true
      }
    },
    {
      "op": "object.set",
      "ref": "HmIP-RF.A:3",
      "body": {
        "meta": {
          "control": null
